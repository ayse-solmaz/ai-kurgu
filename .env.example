# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e eklenmez.

# Ücretsiz stok video yedeği (isteğe bağlı)
# https://www.pexels.com/api/  ve  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Bulut GPU worker'ı ile paylaşılan gizli anahtar (worker'da da aynısı olmalı)
KURGU_WORKER_TOKEN=

# Ses klonlama yalnızca sesin sahibinin onayıyla: onay varsa 1 yapın
KURGU_VOICE_CONSENT=0
