{
  "name": "ai-kurgu-desktop",
  "productName": "AI Kurgu",
  "version": "0.2.2",
  "description": "Açık kaynak, ajan tabanlı AI video kurgu uygulaması",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prepare-backend": "node scripts/prepare-backend.js",
    "dist": "npm run prepare-backend && electron-builder --win nsis",
    "dist:dir": "npm run prepare-backend && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.aikurgu.desktop",
    "productName": "AI Kurgu",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "motion-render.js", "splash.html", "icon.png", "package.json"],
    "extraResources": [
      { "from": "build-backend", "to": "backend" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Kurgu"
    }
  }
}
